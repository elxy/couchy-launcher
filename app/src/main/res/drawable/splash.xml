<?xml version="1.0" encoding="utf-8"?>
<!-- Splash for API 21/22. Plain dark backdrop only: `android:width`,
     `android:height` and `android:gravity` on a <layer-list> item need API 23,
     and on 21/22 the couch would be stretched to fill the whole screen.
     The in-app LoadingScreen (couch + breathing) takes over from here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
</layer-list>
